---
import { PUBLIC_SITE_URL } from "astro:env/client";
import type { Post } from "../lib/types";
import type { ArticleLocale } from "../contracts/article-blocks/v1/types";
import { LANGUAGE_LABELS, messagesFor } from "../lib/i18n";
import { preferredLanguage } from "../lib/host";
import { absoluteUrl, canonicalFor } from "../lib/url";
import { isGeoIpLocaleRoutingEnabled } from "../lib/geoip-config";
import "../styles/global.css";

interface Props {
  title: string;
  description?: string;
  image?: string;
  ogType?: string;
  canonical?: string;
  footerPost?: Post;
  /** Page language; the old site pages stay English. */
  lang?: ArticleLocale;
  /** Mutual hreflang links of the published language versions (site-relative paths). */
  alternates?: { hreflang: string; path: string }[];
  /** Set on article pages so the language switcher can open the same article in another language. */
  articleSlug?: string;
}

const {
  title,
  description,
  image,
  ogType = "website",
  canonical,
  footerPost,
  lang = "en",
  alternates = [],
  articleSlug,
} = Astro.props;

const m = messagesFor(lang);

// Article pages offer only the languages that article is published in; other pages offer every site language.
const switcherLocales = (
  articleSlug
    ? alternates.map((alt) => alt.hreflang).filter((code) => code in LANGUAGE_LABELS)
    : Object.keys(LANGUAGE_LABELS)
) as ArticleLocale[];
const switcherCurrent: ArticleLocale = articleSlug
  ? lang
  : (preferredLanguage(Astro.request, Astro.url.hostname) ?? "en");
const switcherNext = Astro.url.pathname + Astro.url.search;
const showGeoIpAttribution = isGeoIpLocaleRoutingEnabled();

const siteHost = Astro.url.hostname || "web3main.pro";
const siteUrl = PUBLIC_SITE_URL || `https://${siteHost}`;
const siteName = "Web3 Blog";
const orgName = "Web3main LLC";
const orgEmail = `info@${siteHost}`;
const orgPhone = "+123 456 78900";
const orgLogo = absoluteUrl("/storage/blog_images/logo.png");
const defaultDescription = m.defaultDescription;
const metaDescription = description ? description.trim() : defaultDescription;
const metaImage = image
  ? image.trim()
  : absoluteUrl("/storage/blog_images/logo.png");
const metaTitle = title || "Web3 Blog";
const canonicalUrl = canonical || canonicalFor(Astro.url.pathname);

const organizationSchema = {
  "@context": "https://schema.org",
  "@type": "Organization",
  name: orgName,
  url: siteUrl,
  logo: orgLogo,
  email: orgEmail,
  telephone: orgPhone,
  sameAs: ["https://t.me/+17JT99yABvI0OGZi"],
  contactPoint: [
    {
      "@type": "ContactPoint",
      telephone: orgPhone,
      email: orgEmail,
      contactType: "customer support",
      areaServed: "Worldwide",
      availableLanguage: ["English"],
    },
  ],
};

const websiteSchema = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  name: siteName,
  url: siteUrl,
  publisher: {
    "@type": "Organization",
    name: orgName,
    logo: {
      "@type": "ImageObject",
      url: orgLogo,
    },
  },
  inLanguage: "en",
  potentialAction: {
    "@type": "SearchAction",
    target: `${siteUrl}/search?q={search_term_string}`,
    "query-input": "required name=search_term_string",
  },
};

function formatFooterDate(createdAt: string): string {
  return new Date(createdAt).toLocaleDateString("en-US", {
    year: "numeric",
    month: "short",
    day: "numeric",
  });
}

const currentYear = new Date().getFullYear();
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta http-equiv="X-UA-Compatible" content="IE=edge" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <meta name="description" content={metaDescription} />
    <link rel="canonical" href={canonicalUrl} />
    {alternates.map((alt) => <link rel="alternate" hreflang={alt.hreflang} href={absoluteUrl(alt.path)} />)}
    <meta name="robots" content="index,follow" />
    <meta
      name="googlebot"
      content="index,follow,max-snippet:-1,max-image-preview:large,max-video-preview:-1"
    />
    <meta name="author" content={orgName} />

    <title>{metaTitle}</title>

    <meta property="og:site_name" content={siteName} />
    <meta property="og:type" content={ogType} />
    <meta property="og:title" content={metaTitle} />
    <meta property="og:description" content={metaDescription} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={metaImage} />
    <meta property="og:locale" content={lang === "ru" ? "ru_RU" : "en_US"} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={metaTitle} />
    <meta name="twitter:description" content={metaDescription} />
    <meta name="twitter:image" content={metaImage} />

    <script type="application/ld+json" set:html={JSON.stringify(organizationSchema)}>
    </script>
    <script type="application/ld+json" set:html={JSON.stringify(websiteSchema)}>
    </script>

    <!-- Shared front-end styles -->
    <link rel="stylesheet" href="/css/front.css" />

    <!-- Lazy Load CSS -->
    <link rel="stylesheet" href="/css/lazy-load.css" />

    <!-- Font Awesome -->
    <link
      rel="stylesheet"
      href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/5.15.4/css/all.min.css"
      media="print"
      onload="this.media='all'"
    />

    <!-- Favicon -->
    <link rel="icon" type="image/png" href="/favicon.png" />

    <slot name="head_extra" />
  </head>

  <body class="bg-gray-900 text-gray-100">
    <!-- Navigation -->
    <nav class="bg-gray-800 border-b border-gray-700 sticky top-0 z-50">
      <div
        class="container mx-auto px-4 py-2 relative flex items-center justify-between"
      >
        <!-- Logo -->
        <a class="flex-shrink-0" href="/">
          <img
            src="/storage/blog_images/logo.png"
            alt="Wiki BWP resource"
            width="131"
            height="40"
            loading="lazy"
            class="h-10"
          />
        </a>

        <!-- Language switcher -->
        {
          switcherLocales.length > 1 && (
            <form
              method="post"
              action="/api/language-preference"
              class="ml-auto mr-2 md:ml-0 md:mr-0 md:order-last flex items-center gap-1.5"
              title="Language"
            >
              <svg
                xmlns="http://www.w3.org/2000/svg"
                class="h-5 w-5 text-gray-400 flex-shrink-0"
                fill="none"
                viewBox="0 0 24 24"
                stroke="currentColor"
                stroke-width="2"
                aria-hidden="true"
              >
                <circle cx="12" cy="12" r="9"></circle>
                <path d="M3 12h18M12 3c2.5 2.7 3.8 5.7 3.8 9s-1.3 6.3-3.8 9c-2.5-2.7-3.8-5.7-3.8-9S9.5 5.7 12 3z"></path>
              </svg>
              <label for="language-select" class="sr-only">Language</label>
              <select
                id="language-select"
                name="locale"
                class="bg-gray-700 border border-gray-600 text-gray-100 rounded px-2 py-1 text-sm focus:outline-none focus:ring-2 focus:ring-blue-500"
                onchange="this.form.submit()"
              >
                {switcherLocales.map((code) => (
                  <option value={code} selected={code === switcherCurrent}>
                    {LANGUAGE_LABELS[code]}
                  </option>
                ))}
              </select>
              {articleSlug ? (
                <input type="hidden" name="slug" value={articleSlug} />
              ) : (
                <input type="hidden" name="next" value={switcherNext} />
              )}
              <noscript>
                <button type="submit" class="text-sm text-blue-300 underline">OK</button>
              </noscript>
            </form>
          )
        }

        <!-- Burger button (mobile only) -->
        <button
          aria-label={m.nav.menuToggle}
          aria-controls="navbarMenu"
          aria-expanded="false"
          class="md:hidden px-2 py-1 border border-gray-600 rounded text-gray-300 hover:bg-gray-700"
          type="button"
          onclick="toggleMenu()"
        >
          <svg
            xmlns="http://www.w3.org/2000/svg"
            class="h-6 w-6"
            fill="none"
            viewBox="0 0 24 24"
            stroke="currentColor"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              d="M4 6h16M4 12h16M4 18h16"
            ></path>
          </svg>
        </button>

        <div
          id="navbarMenu"
          class="hidden flex flex-col items-stretch gap-3 md:flex md:flex-row md:items-center md:gap-4 absolute sm:static top-full left-0 right-0 bg-gray-800 sm:bg-transparent p-4 sm:p-0 shadow sm:shadow-none text-center mx-3"
        >
          <a
            class="block w-full rounded px-2 py-2 text-gray-300 hover:text-blue-400 font-medium md:w-auto md:rounded-none md:px-0 md:py-0"
            href="/">{m.nav.home}</a
          >
          <a
            class="block w-full rounded px-2 py-2 text-gray-300 hover:text-blue-400 font-medium md:w-auto md:rounded-none md:px-0 md:py-0"
            href="/search">{m.nav.search}</a
          >
          <a
            class="block w-full rounded px-2 py-2 text-gray-300 hover:text-blue-400 font-medium md:w-auto md:rounded-none md:px-0 md:py-0"
            href="/contacts/">{m.nav.contacts}</a
          >

          <a
            class="block w-full rounded px-2 py-2 text-gray-300 hover:text-blue-400 font-medium md:w-auto md:rounded-none md:px-0 md:py-0"
            href="/login">{m.nav.login}</a
          >

          <form
            class="relative w-full md:w-auto"
            role="search"
            method="get"
            action="/search"
          >
            <input
              class="w-full md:w-auto pl-8 pr-4 py-2 md:py-1 border border-gray-600 bg-gray-700 text-gray-100 rounded-full text-sm
                     focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-transparent"
              type="text"
              placeholder={m.searchPlaceholder}
              name="q"
            />
            <svg
              xmlns="http://www.w3.org/2000/svg"
              width="16"
              height="16"
              class="h-4 w-4 absolute left-2.5 top-2 text-gray-400"
              fill="none"
              viewBox="0 0 24 24"
              stroke="currentColor"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"
              ></path>
            </svg>
          </form>
        </div>
      </div>

      <script is:inline>
        function toggleMenu() {
          const hidden = document.getElementById("navbarMenu").classList.toggle("hidden");
          document
            .querySelector('[aria-controls="navbarMenu"]')
            ?.setAttribute("aria-expanded", String(!hidden));
        }

        globalThis.toggleMenu = toggleMenu;
      </script>
    </nav>

    <!-- Main Content -->
    <main role="main">
      <div class="bg-gray-900 mt-6">
        <div class="container mx-auto px-4 max-w-7xl">
          <div class="flex flex-wrap">
            <slot />
          </div>
        </div>
      </div>
    </main>

    <!-- Footer -->
    <footer class="bg-gray-800 text-white pt-12 mt-12 border-t border-gray-700">
      <div class="container mx-auto px-4">
        <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
          <!-- About Section -->
          <div>
            <div class="mb-4">
              <img
                src="/storage/blog_images/footer-logo.png"
                alt="Web3 Blog"
                width="157"
                height="48"
                loading="lazy"
                class="h-12"
              />
            </div>
            <p class="text-gray-300 mb-4">{m.footer.tagline}</p>
            <div>
              <h4 class="text-lg font-semibold uppercase mb-2">{m.footer.contactInfo}</h4>
              <p class="text-gray-300 mb-1">10 Rustaveli Avenue, Tbilisi, Georgia</p>
              <p class="text-gray-300 mb-1">Phone: +123 456 78900</p>
              <p class="text-gray-300">info@{siteHost}</p>
            </div>
          </div>

          <!-- Testimonials -->
          <div>
            <h3 class="text-lg font-semibold uppercase mb-4">{m.footer.testimonials}</h3>
            <div class="bg-gray-700 p-4 rounded">
              <div class="text-gray-300 italic mb-4">
                <p>{m.footer.testimonial}</p>
              </div>
              <div class="flex items-center">
                <img
                  src="/storage/blog_images/author.png"
                  alt=""
                  loading="lazy"
                  class="w-10 h-10 rounded-full mr-3"
                />
                <div>
                  <h4 class="font-semibold">Sophia</h4>
                  <p class="text-sm text-gray-400">{m.footer.role}</p>
                </div>
              </div>
            </div>
          </div>

          <!-- Custom Post Section -->
          <div>
            <h3 class="text-lg font-semibold uppercase mb-4">{m.footer.customCategory}</h3>
            {
              footerPost ? (
                <div class="flex items-start">
                  <div class="flex-shrink-0 mr-3">
                    <a href={`/post/${footerPost.slug}`}>
                      <img
                        src={footerPost.image_url}
                        alt={footerPost.title}
                        loading="lazy"
                        class="w-20 h-20 object-cover rounded"
                      />
                    </a>
                  </div>
                  <div>
                    <a
                      href={`/post/${footerPost.slug}`}
                      class="text-white hover:text-blue-300 font-medium"
                    >
                      {footerPost.title}
                    </a>
                    <p class="text-sm text-gray-400 mt-1">
                      {formatFooterDate(footerPost.created_at)}
                    </p>
                  </div>
                </div>
              ) : (
                <p class="text-sm text-gray-400">{m.footer.noPosts}</p>
              )
            }
          </div>
        </div>
      </div>

      <!-- Copyright -->
      <div class="py-4 mt-8 bg-gray-900">
        <div class="container mx-auto px-4">
          <div class="text-center text-gray-400">
            &copy; 2019-{currentYear}
            <a href="#" class="hover:text-white">Web3 blog, </a> Designed with
            <i class="fas fa-heart text-red-500"></i> and <a href="#" class="hover:text-white">Astro</a
            >
            &nbsp;·&nbsp;
            <a href="/privacy/" class="text-blue-400 hover:text-blue-300"
              >{m.footer.privacy}</a
            >
            {showGeoIpAttribution && (
              <>
                &nbsp;·&nbsp;
                <a href="https://db-ip.com" class="text-blue-400 hover:text-blue-300" rel="noopener noreferrer">
                  IP Geolocation by DB-IP
                </a>
              </>
            )}
          </div>
        </div>
      </div>
    </footer>

    <!-- Front-end behaviour: likes, lazy loading -->
    <script src="/js/front.js" defer></script>
    <script src="/js/lazy-load.js" defer></script>
    <script
      src="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/5.15.4/js/all.min.js"
      defer></script>

    <slot name="javascripts" />
  </body>
</html>

---
export const prerender = false;

import Layout from "../../layouts/Layout.astro";
import LazyImage from "../../components/LazyImage.astro";
import { getPost, ApiClientError } from "../../lib/api";
import type { PostResponse } from "../../lib/types";
import { formatDate, fromNow, excerpt } from "../../lib/format";
import { absoluteUrl } from "../../lib/url";
import { resolveArticle } from "../../lib/articles";
import { isWwwHost, preferredLanguage } from "../../lib/host";
import { messagesFor } from "../../lib/i18n";
import {
  parseLanguagePreference,
  selectPublishedLocale,
} from "../../lib/language-choice";
import { isGeoIpLocaleRoutingEnabled } from "../../lib/geoip-config";

const { slug } = Astro.params;
const preferredLang =
  preferredLanguage(Astro.request, Astro.url.hostname) ?? undefined;
const m = messagesFor(preferredLang ?? "en");

let resolution: Awaited<ReturnType<typeof resolveArticle>> | null = null;
try {
  resolution = await resolveArticle(slug!);
} catch (error) {
  // Older posts are served by the legacy endpoint; only a resolver 404 falls through.
  if (!(error instanceof ApiClientError) || error.status !== 404) throw error;
}

if (resolution?.route_mode === "neutral") {
  const preference = parseLanguagePreference(
    Astro.request.headers.get("cookie")
  );
  const preferenceIsPublished =
    preference !== null &&
    resolution.locales.some(locale => locale.locale === preference);
  // www.<host> only serves readers in Russia (the middleware sends everyone else away), so the host decides.
  const countryCode =
    !preferenceIsPublished &&
    isGeoIpLocaleRoutingEnabled() &&
    isWwwHost(Astro.url.hostname)
      ? "RU"
      : null;
  const locale = selectPublishedLocale(resolution, preference, countryCode);
  if (!locale) {
    Astro.response.status = 404;
    return Astro.rewrite("/404");
  }

  const response = Astro.redirect(
    `/${locale}/post/${encodeURIComponent(slug!)}`,
    302
  );
  response.headers.set("Cache-Control", "private, no-store");
  response.headers.set("Vary", "Cookie");
  return response;
}

let data: PostResponse;
try {
  data = await getPost(slug!, Astro, preferredLang);
} catch (error) {
  if (error instanceof ApiClientError && error.status === 404) {
    Astro.response.status = 404;
    return Astro.rewrite("/404");
  }
  throw error;
}

const post = data.post;
const defaultDescription =
  "Stay updated with the latest trends in Web3 development, software engineering tips, and best coding practices for modern applications.";
const shortDescription =
  excerpt(post.description || post.content, 157) || defaultDescription;
const title = `${post.title} - Web3 Blog`;
const absoluteImage = absoluteUrl(post.image_url);

const shareUrl = encodeURIComponent(absoluteUrl(`/post/${post.slug}`));
const shareTitle = encodeURIComponent(post.title);
---

<Layout
  title={title}
  description={shortDescription}
  image={absoluteImage}
  ogType="article"
  canonical={absoluteUrl(`/post/${post.slug}`)}
>
  <div class="article-page -mx-2 mx-auto w-[calc(100%+1rem)] max-w-[760px] min-w-0 sm:mx-auto sm:w-full">
    <article class="overflow-hidden rounded-lg border border-gray-700 bg-gray-800 shadow-sm">
      {post.image_url && (
        <div class="flex h-64 w-full items-center justify-center overflow-hidden bg-gray-700 md:h-96 [&>.lazy-wrap]:h-full [&>.lazy-wrap]:w-full">
          <LazyImage
            src={post.image_url}
            alt={post.title}
            class="h-full w-full object-contain"
            height="384"
          />
        </div>
      )}

      <div class="px-1 py-6 sm:p-6">
        <header class="mb-6 text-center">
          {post.category && (
            <h6 class="mb-2 text-sm">
              <a
                href={`/category/${post.category.slug}`}
                class="text-blue-500 hover:text-blue-700"
              >
                {post.category.title}
              </a>
            </h6>
          )}
          <h1 class="mb-2 text-3xl font-bold text-white">{post.title}</h1>
        </header>

        <div class="prose max-w-none">
          <Fragment set:html={post.content} />
        </div>

        {data.aphorism && (
          <div class="mt-8">
            <h4 class="mb-2 font-semibold text-white">Quote of the day:</h4>
            <div class="m-2 flex items-center rounded-sm border-2 bg-gray-700 p-2 text-white">
              {data.aphorism.text}
            </div>
          </div>
        )}

        {post.tags && post.tags.length > 0 && (
          <div class="mt-6 mb-4 flex flex-wrap">
            {post.tags.map(tag => (
              <a
                href={`/tag/${tag.slug}`}
                class="mr-2 mb-2 rounded-full bg-gray-700 px-3 py-1 text-sm text-white transition hover:bg-gray-600"
              >
                {tag.title}
              </a>
            ))}
          </div>
        )}

        <div class="flex items-center justify-between border-t border-gray-700 pt-4 text-sm text-gray-400">
          <span>
            {post.author && (
              <>
                By{" "}
                <a href="#" class="hover:text-blue-400">
                  {post.author.name}
                </a>{" "}
              </>
            )}
            On <b>{formatDate(post.created_at)}</b>
          </span>

          <div class="flex items-center">
            <span class="mr-4 flex items-center">
              <i class="fas fa-eye mr-1"></i>
              {post.views_count}
            </span>
            <a
              class="group flex w-full items-center sm:w-auto"
              onclick="Likes.toggle(this,event);"
              data-post_id={post.id}
              href="#"
              title="Like"
            >
              <i class="far fa-heart heart-icon mr-1 text-red-500 transition-transform duration-500"></i>
              <span class="like_button_count transition-colors duration-500 group-hover:text-blue-400">
                {post.likes_count}
              </span>
            </a>

            <div class="ml-4 flex items-center space-x-2">
              <a
                href={`https://t.me/share/url?url=${shareUrl}&text=${shareTitle}`}
                target="_blank"
                rel="noopener noreferrer"
                class="text-gray-400 transition-colors hover:text-blue-400"
                title="Share on Telegram"
                aria-label="Share on Telegram"
              >
                <i class="fab fa-telegram" aria-hidden="true"></i>
              </a>
              <a
                href={`https://twitter.com/intent/tweet?url=${shareUrl}&text=${shareTitle}`}
                target="_blank"
                rel="noopener noreferrer"
                class="text-gray-400 transition-colors hover:text-blue-400"
                title="Share on X (Twitter)"
                aria-label="Share on X (Twitter)"
              >
                <i class="fab fa-twitter" aria-hidden="true"></i>
              </a>
              <a
                href={`https://www.linkedin.com/sharing/share-offsite/?url=${shareUrl}`}
                target="_blank"
                rel="noopener noreferrer"
                class="text-gray-400 transition-colors hover:text-blue-400"
                title="Share on LinkedIn"
                aria-label="Share on LinkedIn"
              >
                <i class="fab fa-linkedin" aria-hidden="true"></i>
              </a>
            </div>
          </div>
        </div>
      </div>
    </article>

    <!-- Comments Section -->
    <div class="mt-8">
      {post.comments?.map(comment => (
        <div class="mb-4 flex rounded-lg border border-gray-700 bg-gray-800 p-4">
          <div class="mr-4 flex-shrink-0">
            <img
              class="h-12 w-12 rounded-full object-cover"
              src="/storage/blog_images/comment.jpg"
              alt={comment.author_name}
            />
          </div>
          <div>
            <h5 class="font-semibold text-white">{comment.author_name}</h5>
            <p class="mb-2 text-xs text-gray-400">
              {fromNow(comment.created_at)}
            </p>
            <p class="text-gray-300">{comment.text}</p>
          </div>
        </div>
      ))}
    </div>

    <!-- Comment Form -->
    <div class="mt-8 rounded-lg border border-gray-700 bg-gray-800 p-6">
      <h4 class="mb-4 text-xl font-semibold text-white">Leave a reply</h4>

      <div id="comment-flash"></div>

      <form
        class="w-full"
        role="form"
        method="post"
        action="/api/comment"
        id="comment-form"
      >
        <input type="hidden" name="post_id" value={post.id} />
        <div class="mb-4">
          {/* Honeypot field - should remain empty */}
          <input type="text" name="honeypot" value="" style="display:none;" />

          {/* Anti-bot counter */}
          <input type="hidden" class="countMe" name="countMe" value="0" />

          <textarea
            required
            class="w-full rounded-md border border-gray-600 bg-gray-700 p-3 text-white placeholder-gray-400 focus:border-transparent focus:ring-2 focus:ring-blue-500 focus:outline-none"
            rows="4"
            name="message"
            placeholder="Write some comment"
            onkeyup="count_keyup()"
          ></textarea>
        </div>
        <button class="rounded-md bg-blue-500 px-6 py-2 font-medium text-white transition duration-200 hover:bg-blue-600">
          Post Comment
        </button>
      </form>

      <script>
        const form = document.getElementById(
          "comment-form"
        ) as HTMLFormElement | null;
        const flashDiv = document.getElementById("comment-flash");

        if (form) {
          form.addEventListener("submit", async e => {
            e.preventDefault();

            const formData = new FormData(form);

            try {
              const response = await fetch("/api/comment", {
                method: "POST",
                body: formData,
              });

              const result = await response.json().catch(() => ({}));

              if (response.ok) {
                if (flashDiv) {
                  flashDiv.innerHTML =
                    '<div class="bg-green-500 text-white p-3 rounded mb-4">' +
                    (result.message || "your comment will be added soon") +
                    "</div>";
                }
                form.reset();
                form
                  .querySelectorAll<HTMLInputElement>('input[name="countMe"]')
                  .forEach(input => (input.value = "0"));
              } else if (flashDiv) {
                flashDiv.innerHTML =
                  '<div class="bg-red-500 text-white p-3 rounded mb-4">' +
                  (result.message || "Failed to post comment.") +
                  "</div>";
              }
            } catch {
              if (flashDiv) {
                flashDiv.innerHTML =
                  '<div class="bg-red-500 text-white p-3 rounded mb-4">Failed to post comment.</div>';
              }
            }
          });
        }
      </script>
    </div>
    <div class="article-related mt-8 space-y-8">
      {[
        { title: m.sidebar.featured, posts: data.featured_posts },
        { title: m.sidebar.recent, posts: data.recent_posts },
      ].map(section => (
        <section>
          <h2 class="mb-4 text-xl font-semibold text-white">{section.title}</h2>
          <div class="space-y-3">
            {section.posts.map(item => (
              <a
                href={`/post/${item.slug}`}
                class="flex items-center gap-4 rounded-lg border border-gray-700 bg-gray-800 p-3 hover:border-gray-500"
              >
                {item.image_url && (
                  <img
                    src={item.image_url}
                    alt=""
                    loading="lazy"
                    class="h-16 w-24 rounded object-cover"
                  />
                )}
                <span class="min-w-0 flex-1 font-medium text-gray-200">
                  {item.title}
                </span>
                <time class="shrink-0 text-xs text-gray-400">
                  {formatDate(item.created_at)}
                </time>
              </a>
            ))}
          </div>
        </section>
      ))}
      <section>
        <h2 class="mb-4 text-xl font-semibold text-white">Categories</h2>
        <div class="flex flex-wrap gap-2">
          {data.categories.map(category => (
            <a
              href={`/category/${category.slug}`}
              class="rounded-full border border-gray-700 bg-gray-800 px-3 py-1 text-sm text-gray-300 hover:text-blue-400"
            >
              {category.title}{" "}
              <span class="text-gray-500">({category.posts_count})</span>
            </a>
          ))}
        </div>
      </section>
    </div>
  </div>
</Layout>

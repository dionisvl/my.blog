---
export const prerender = false;

import Layout from "../layouts/Layout.astro";

const host = Astro.url.hostname || "web3main.pro";
const title = "Contacts - Web3 Blog";
const description = `Contact information for ${host}. Get in touch with us for inquiries, feedback, and support.`;
---

<Layout title={title} description={description}>
  <div class="w-full pr-0 md:w-3/4 md:pr-6">
    <div class="overflow-hidden rounded-lg border border-gray-700 bg-gray-800 p-6 shadow-sm">
      <h1 class="mb-6 text-2xl font-bold text-white">Contacts</h1>

      <div class="mb-6 text-gray-300">
        <p class="mb-2">
          <span class="font-semibold text-white">Our address:</span>
          10 Rustaveli Avenue, Tbilisi, Georgia
        </p>
        <p class="mb-2">Mon-Fri 9.00 - 19.00</p>
        <p>
          <span class="font-semibold text-white">E-mail:</span>
          <a
            href={`mailto:info@${host}`}
            class="text-blue-400 hover:text-blue-300"
          >
            info@{host}
          </a>
        </p>
      </div>

      <div
        id="map_container"
        class="relative mb-6 h-96 w-full rounded bg-gray-700 bg-center bg-no-repeat"
        style="background-image: url(/storage/uploads/common/ymap0.webp);"
      >
        <script
          id="ymap_lazy"
          data-skip-moving="true"
          async=""
          data-src="https://api-maps.yandex.com/services/constructor/1.0/js/?um=constructor%3A09fb52cdf1297e9cde612f27192a2ce7671dc4dc5ae01806ce6cf9a18b719793&width=1280&height=400&lang=en_US&scroll=true"
        ></script>
      </div>

      <script is:inline>
        const map_container = document.getElementById("map_container");
        const options_map = {
          once: true,
          passive: true,
          capture: true,
        };
        map_container.addEventListener("click", start_lazy_map, options_map);
        map_container.addEventListener(
          "mouseover",
          start_lazy_map,
          options_map
        );
        map_container.addEventListener(
          "touchstart",
          start_lazy_map,
          options_map
        );
        map_container.addEventListener(
          "touchmove",
          start_lazy_map,
          options_map
        );

        let map_loaded = false;

        function start_lazy_map() {
          if (!map_loaded) {
            const map_block = document.getElementById("ymap_lazy");
            map_loaded = true;
            map_block.setAttribute("src", map_block.getAttribute("data-src"));
            map_block.removeAttribute("data-src");
          }
        }
      </script>
    </div>
  </div>

  <div class="w-full md:w-1/4">
    <div class="sticky top-4 space-y-3">
      <div class="overflow-hidden rounded-lg border border-gray-700 bg-gray-800 p-4 shadow-sm">
        <h3 class="mb-4 text-center text-lg font-semibold text-gray-100">
          Contact Information
        </h3>
        <div class="space-y-2 text-sm text-gray-300">
          <p>
            <i class="fas fa-map-marker-alt mr-2 text-blue-400"></i>
            Tbilisi, Georgia
          </p>
          <p>
            <i class="fas fa-phone mr-2 text-blue-400"></i>
            +123 456 78900
          </p>
          <p>
            <i class="fas fa-envelope mr-2 text-blue-400"></i>
            info@{host}
          </p>
        </div>
      </div>
    </div>
  </div>
</Layout>

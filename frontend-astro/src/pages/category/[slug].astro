---
export const prerender = false;

import Layout from "../../layouts/Layout.astro";
import Sidebar from "../../components/Sidebar.astro";
import LazyImage from "../../components/LazyImage.astro";
import { getCategory, getHome, ApiClientError } from "../../lib/api";
import type { CategoryResponse, HomeResponse } from "../../lib/types";
import { formatDate } from "../../lib/format";
import { canonicalFor } from "../../lib/url";
import {
  isPageOutOfRange,
  pageHref,
  pageRedirectLocation,
  parsePageParam,
} from "../../lib/pagination";
import Pagination from "../../components/Pagination.astro";
import PaginationLinks from "../../components/PaginationLinks.astro";
import { preferredLanguage } from "../../lib/host";

const { slug } = Astro.params;
const preferredLang =
  preferredLanguage(Astro.request, Astro.url.hostname) ?? undefined;
Astro.response.headers.set("Vary", "Cookie");
const basePath = Astro.url.pathname;
const pageQuery = parsePageParam(Astro.url.searchParams.get("page"));
if (pageQuery.redirect) {
  return Astro.redirect(
    pageRedirectLocation(basePath, Astro.url.searchParams, pageQuery.page),
    301
  );
}
const page = pageQuery.page;

let data: CategoryResponse;
let home: HomeResponse;
try {
  data = await getCategory(slug!, page, preferredLang);
  home = await getHome(1, preferredLang);
} catch (error) {
  if (error instanceof ApiClientError && error.status === 404) {
    Astro.response.status = 404;
    return Astro.rewrite("/404");
  }
  throw error;
}
if (isPageOutOfRange(page, data.pagination.total_pages)) {
  Astro.response.status = 404;
  return Astro.rewrite("/404");
}

const category = data.category;
const title = `${category.title}${page > 1 ? `, page ${page}` : ""} - Web3 Blog`;
const description =
  category.preview_text ||
  `Browse articles in ${category.title}. Explore our curated collection of posts on this topic.`;
---

<Layout
  title={title}
  description={description}
  canonical={canonicalFor(pageHref(basePath, page))}
>
  <PaginationLinks
    slot="head_extra"
    page={data.pagination.current_page}
    totalPages={data.pagination.total_pages}
    basePath={basePath}
  />
  <div class="w-full space-y-3 pr-0 md:w-3/4 md:pr-6">
    <div class="mb-6 rounded-lg p-4">
      <h1 class="mb-3 text-2xl font-semibold text-white">{category.title}</h1>
      <blockquote class="text-gray-300">all posts by filter</blockquote>
    </div>

    {data.posts.length === 0 ? (
      <div class="overflow-hidden rounded-lg border border-gray-700 bg-gray-800 p-6 shadow-sm">
        <p class="text-gray-300">No posts found for this filter.</p>
      </div>
    ) : (
      data.posts.map(post => (
        <article class="overflow-hidden rounded-lg border border-gray-700 bg-gray-800 shadow-sm">
          <a
            href={`/post/${post.slug}`}
            class="flex flex-col transition-all duration-200 hover:bg-gray-700 hover:shadow-md"
          >
            <div class="flex flex-row">
              <div class="flex w-32 flex-shrink-0 items-center justify-center p-1">
                <div class="flex h-12 w-full items-center justify-center overflow-hidden">
                  <LazyImage
                    src={post.image_url}
                    alt={post.title}
                    class="h-12 w-auto object-contain transition-transform duration-300 group-hover:scale-110"
                    width="100"
                    height="50"
                  />
                </div>
              </div>
              <header class="flex flex-grow items-center p-1 px-3">
                <h3 class="text-lg font-semibold text-white transition group-hover:text-blue-400">
                  {post.title}
                </h3>
              </header>
            </div>
            {post.description && (
              <div class="px-4 pb-4">
                <div class="prose line-clamp-2 max-w-none text-sm text-gray-300 transition-colors hover:text-blue-300">
                  <Fragment set:html={post.description} />
                </div>
              </div>
            )}
          </a>
          <div class="flex items-center justify-between border-t border-gray-700 p-1 pl-4 text-sm text-gray-400">
            <span>
              By{" "}
              <a href="#" class="hover:text-blue-400">
                {post.author?.name}
              </a>{" "}
              on {formatDate(post.created_at)}
            </span>
            <div class="flex flex-wrap items-center space-x-0 sm:mr-4 sm:space-x-4">
              <span class="flex w-full items-center sm:w-auto">
                <i class="fas fa-eye mr-1" />
                {post.views_count}
              </span>
            </div>
          </div>
        </article>
      ))
    )}

    <Pagination pagination={data.pagination} basePath={basePath} />
  </div>

  <Sidebar
    categories={home.categories}
    featuredPosts={home.featured_posts}
    recentPosts={home.recent_posts}
  />
</Layout>

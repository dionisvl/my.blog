---
export const prerender = false;

import Layout from "../layouts/Layout.astro";

Astro.response.status = 404;

const title = "404 - Page Not Found";
const description = "Page not found. The requested resource does not exist.";
---

<Layout title={title} description={description}>
  <div class="w-full pr-0 md:w-3/4 md:pr-6">
    <div class="overflow-hidden rounded-lg border border-gray-700 bg-gray-800 p-8 text-center shadow-sm">
      <h1 class="mb-4 text-3xl font-bold text-white">404</h1>
      <h2 class="mb-3 text-xl font-semibold text-gray-100">Page Not Found</h2>
      <p class="mb-6 text-gray-300">
        Sorry, the page you are looking for doesn't exist or has been moved.
        Please try returning to our homepage or going back to the previous page.
      </p>
      <div class="flex justify-center space-x-4">
        <a
          href="/"
          class="rounded-md bg-blue-500 px-6 py-2 font-medium text-white transition duration-200 hover:bg-blue-600"
        >
          Go to Homepage
        </a>
        <button
          onclick="history.back()"
          class="rounded-md bg-gray-700 px-6 py-2 font-medium text-white transition duration-200 hover:bg-gray-600"
        >
          Go Back
        </button>
      </div>
    </div>
  </div>
</Layout>

# Hostnames for Traefik routing
MAIN_HOST=blog.test
API_GO_HOST=api.blog.test
OLD_HOST=old-example.com

# App
APP_ENV=dev
#APP_DEBUG=1
CANONICAL_DOMAIN=example.com
GO_API_KEY=change-me-in-production

# pets-app: host directory with its code, served from <dir>/public
PETS_APP_DIR=./pets-app

# Image versions
ALERTMANAGER_VERSION=v0.35.0
CADVISOR_VERSION=v0.60.6
GRAFANA_VERSION=13.3.1
IMAGE_GO_VERSION=1.27.4
IMAGE_NODE_DIGEST=sha256:6bd9ab43c0ec0190ca7b2d193906cb8b7edf6e7f4afa43ddeccd6452710bffb5
IMAGE_NODE_VERSION=26.13.1
IMAGE_PNPM_VERSION=12.21.0
IMAGE_POSTGRES_VERSION=18.7
JAEGER_VERSION=2.23.0
NODE_EXPORTER_VERSION=v1.12.1
PHP_VERSION=8.4.28
PROMETHEUS_VERSION=v3.16.0
TRAEFIK_VERSION="v3.7.19"
VECTOR_VERSION=0.61.0
VICTORIA_LOGS_VERSION=v1.54.0
VMAUTH_VERSION=v1.156.0

# PostgreSQL
POSTGRES_DB=my_blog
POSTGRES_USER=app
POSTGRES_PASSWORD=***
DB_PORT_EXTERNAL=54321

# Logs: vmauth users
VMAUTH_ADMIN_USER=***
VMAUTH_ADMIN_PASS=***
VMAUTH_READONLY_USER=***
VMAUTH_READONLY_PASS=***

# Monitoring: Grafana admin
GRAFANA_ADMIN_USER=xxx
GRAFANA_ADMIN_PASSWORD=xxx

# Prod only: registry, TLS
DOCKER_REGISTRY_SERVER="registry.example.com"
ACME_EMAIL=admin@example.com

# Prod only: BasicAuth (htpasswd -nB username, escape $ as $$)
DASHBOARD_AUTH="<admin>:<hashed-password>"
JAEGER_AUTH=admin:***(htpasswd)
PROMETHEUS_AUTH="user:pass"
GRAFANA_AUTH="user:pass"
ALERTMANAGER_AUTH="user:pass"

# Prod only: media-s3 credentials
MEDIA_S3_KEY=change-me
MEDIA_S3_SECRET=change-me

# Prod only: geo-IP host routing, see Docs/geoip-host-routing.md
GEOIP_LOCALE_ROUTING_ENABLED=false

# Prod only, optional: Google Search Console meta tag
PUBLIC_GOOGLE_SITE_VERIFICATION=

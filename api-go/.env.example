# api-go environment variables

# Database connection URL
DATABASE_URL=postgres://app:secret@postgres:5432/my_blog?sslmode=disable

# API key for authenticating requests
API_KEY=change-me-in-production

# Application environment (dev|prod)
APP_ENV=dev

# Comma-separated list of allowed CORS origins
CORS_ALLOWED_ORIGINS="http://blog.test,http://api.blog.test"

# Canonical public host; SEO files and contacts are served for it
MAIN_HOST=blog.test

# Public contact address (optional; defaults to info@<MAIN_HOST>)
CONTACT_EMAIL=

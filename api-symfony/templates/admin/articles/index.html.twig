{% extends 'admin/layout.html.twig' %}

{% block title %}Modular articles{% endblock %}

{% block content %}
    <div class="content-wrapper">
        <section class="content-header">
            <h1>Modular articles <small>block-based, RU/EN</small></h1>
        </section>
        <section class="content">
            {% for type, messages in app.flashes %}
                {% for message in messages %}
                    <div class="alert alert-{{ type }}">{{ message }}</div>
                {% endfor %}
            {% endfor %}
            <div class="box">
                <div class="box-header with-border">
                    <a class="btn btn-success" href="{{ path('admin_articles_new') }}">New article</a>
                </div>
                <div class="box-body">
                    <table class="table table-bordered table-hover">
                        <thead>
                        <tr>
                            <th>Slug</th>
                            <th>Working title</th>
                            {% for locale in locales %}<th>{{ locale|upper }}</th>{% endfor %}
                        </tr>
                        </thead>
                        <tbody>
                        {% for row in rows %}
                            <tr>
                                <td>{{ row.post.slug }}</td>
                                <td>{{ row.post.title }}</td>
                                {% for locale in locales %}
                                    {% set item = row.locales[locale] ?? null %}
                                    <td>
                                        <a href="{{ path('admin_articles_edit', {id: row.post.id, locale: locale}) }}">
                                            {% if item is null %}not started{% elseif item.published %}published{% else %}draft{% endif %}
                                        </a>
                                        {% if item is not null and item.published %}
                                            · <a target="_blank" rel="noopener" href="/{{ locale }}/post/{{ row.post.slug }}">open</a>
                                        {% endif %}
                                    </td>
                                {% endfor %}
                            </tr>
                        {% else %}
                            <tr><td colspan="{{ 2 + locales|length }}" class="text-center">No modular articles yet.</td></tr>
                        {% endfor %}
                        </tbody>
                    </table>
                </div>
            </div>
        </section>
    </div>
{% endblock %}
